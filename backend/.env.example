# KAVACH backend — environment template.
# Copy to `.env` in this directory (backend/.env) and fill in real values.
# NEVER commit the real `.env` file — it is already in .gitignore.

# --- Identity / runtime mode -------------------------------------------
APP_NAME="KAVACH Backend"
# One of: development | demo | sovereign | test
ENVIRONMENT=development
# When true, the model gateway, artifact tools and sandbox (Phase 5/8)
# refuse to initialize against any non-local endpoint.
SOVEREIGN_MODE=false

# --- Network -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list, parsed as JSON array by pydantic-settings, e.g.
# ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# --- Database --------------------------------------------------------------
# Async SQLAlchemy URL. The docker-compose.yml default matches this.
DATABASE_URL=postgresql+asyncpg://kavach:REPLACE_ME@127.0.0.1:5432/kavach
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# --- Storage -----------------------------------------------------------------
STORAGE_ROOT=./data/storage
MAX_UPLOAD_BYTES=52428800

# --- Auth (scaffolded now, enforced starting Phase 2) -------------------------
# MUST be overridden to a real random value outside ENVIRONMENT=development.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=REPLACE_ME_DEV_ONLY_NOT_FOR_PRODUCTION
SESSION_TTL_MINUTES=720

# --- Bounded execution limits (agent, Phase 4) ---------------------------------
MAX_AGENT_STEPS=25
MAX_TOOL_CALLS=50
MAX_RUN_SECONDS=600
MAX_RETRY_COUNT=3

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Postgres container credentials (docker-compose.yml reads these directly) --
POSTGRES_USER=kavach
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=kavach
